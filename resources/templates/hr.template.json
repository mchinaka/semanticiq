            "from": "Submitted",
            "to": "Approved",
            "guard": {
              "expr": {
                "and": [
                  {
                    "or": [
                      { "not": { "var": "requiresDirectorApproval" } },
                      {
                        "==": [
                          { "var": "actor.user_id" },
                          { "var": "approver" }
